# MySQL (cPanel > MySQL Databases: create the database and a user, add the user to the database with ALL PRIVILEGES).
# cPanel prefixes names with your account name, e.g. myuser_signature
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin panel login at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie
ADMIN_SECRET=change-me-too

# Public address of the live site, no trailing slash. Needed so Shiprocket can show your product photos and send customers back.
SITE_URL=https://yourdomain.com

# Shiprocket Checkout. Leave the key and secret empty to keep the site's own order form (no online payment).
# Key and secret come from Shiprocket. The secret must stay on the server only.
SHIPROCKET_API_KEY=
SHIPROCKET_API_SECRET=
# Only change these for Shiprocket's test servers:
# SHIPROCKET_API_BASE=https://checkout-api.shiprocket.com
# SHIPROCKET_UI_BASE=https://checkout-ui.shiprocket.com
