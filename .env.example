# MySQL (cPanel > MySQL Databases: create the database and a user, add the user to the database with ALL PRIVILEGES).
# cPanel prefixes names with your account name, e.g. myuser_signature
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin panel login at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie
ADMIN_SECRET=change-me-too

# Optional: lock the Shiprocket catalog APIs with the X-Api-Key Shiprocket gives you
SHIPROCKET_API_KEY=
